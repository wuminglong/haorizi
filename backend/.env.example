# Database: omit DATABASE_URL to use backend/haorizi_dev.db locally.
# DATABASE_URL=sqlite:////absolute/path/to/haorizi_dev.db
# Production example:
# DATABASE_URL=mysql+pymysql://haorizi:change-me@127.0.0.1:3306/haorizi?charset=utf8mb4

# API / session
APP_NAME=HaoRiZi
SESSION_SECRET=change-this-to-a-long-random-string
GROUP_SESSION_COOKIE_NAME=haorizi_group_session
GROUP_SESSION_DAYS=30
ADMIN_SESSION_COOKIE_NAME=haorizi_admin_session
ADMIN_SESSION_HOURS=12
ADMIN_TOKEN=dev-admin-token
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTO_CREATE_TABLES=false

# PushPlus
PUSHPLUS_ENABLED=false
PUSHPLUS_TOKEN=
PUSHPLUS_SECRET_KEY=
PUSHPLUS_QR_SECONDS=604800
PUSHPLUS_QR_SCAN_COUNT=-1

# Rate limit
JOIN_RATE_LIMIT_PER_MINUTE=10
JOIN_RATE_LIMIT_PER_10_MINUTES=30
JOIN_ERROR_COOLDOWN_THRESHOLD=8
JOIN_ERROR_COOLDOWN_SECONDS=900
CREATE_GROUP_RATE_LIMIT_PER_MINUTE=5
CREATE_GROUP_RATE_LIMIT_PER_HOUR=20
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_ERROR_COOLDOWN_THRESHOLD=5
ADMIN_LOGIN_ERROR_COOLDOWN_SECONDS=900
WRITE_RATE_LIMIT_PER_MINUTE=30

# Worker
REMINDER_SCAN_INTERVAL_SECONDS=60
REMINDER_RETRY_DELAY_SECONDS=300
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=3
REMINDER_PROCESSING_TIMEOUT_SECONDS=900
